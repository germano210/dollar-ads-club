# Copie para .env (o .env NUNCA vai para o GitHub)
DAC_URL=https://loudhouse.com.br
DAC_BASE=dollar-ads-club
# Segredo longo (ex.: python -c "import secrets;print(secrets.token_urlsafe(32))"); o mesmo vai no Worker como SEGREDO
ORIGEM_SEGREDO=
# Mercado Livre (DevCenter): redirect = https://loudhouse.com.br/dollar-ads-club/oauth/callback
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_TIPO_ANUNCIO=gold_special
# Mercado Pago (credenciais de produção)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Regras de negócio
PRECO_CREDITO=1.00
GANHO_CENTAVOS=10
SAQUE_MIN_CENTAVOS=1000
LIBERAR_DIAS=0
BONUS_CREDITOS_DIA=10
BONUS_DIAS=30
# IA (opcional: variação de título/descrição)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# esforço da IA: low | medium | high
ANTHROPIC_EFFORT=
